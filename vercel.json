{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/tts/azure.js": { "maxDuration": 60 },
    "api/tts/edge.py": { "maxDuration": 60 },
    "api/gen/export.js": { "maxDuration": 300 },
    "api/gen/jobs.js": { "maxDuration": 300 },
    "api/gen/jobs/download.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
